{
  "name": "exchange-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade hybrid exchange monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" --filter=\"./services/*\" --filter=\"./apps/*\" run build",
    "test": "vitest run",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sol,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,sol,sql}\"",
    "dev": "node scripts/dev.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/uuid": "^11.0.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
