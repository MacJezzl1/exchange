# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# PRODUCTION HYBRID EXCHANGE PLATFORM
# Copy to .env for local development with realistic test values.
# NEVER commit production credentials or actual private keys to source control.
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug

# Service Ports & Endpoints
PORT_API_GATEWAY=8080
PORT_ADMIN_API=8081
PORT_IDENTITY=8082
PORT_KYC=8083
PORT_LEDGER=8084
PORT_TRADING=8085
PORT_MATCHING_ENGINE=8086
PORT_MARKET_DATA=8087
PORT_SETTLEMENT=8088
PORT_CHAIN_WATCHER=8089
PORT_CUSTODY_FIAT=8090
PORT_RISK=8091
PORT_COMPLIANCE=8092
PORT_NOTIFICATIONS=8093

# Web Apps
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
STATUS_PAGE_URL=http://localhost:3002

# PostgreSQL 16
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=exchange
DATABASE_USER=exchange_app
DATABASE_PASSWORD=replace_with_secure_dev_password
DATABASE_SSL=false
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Domain Specific DB Roles (Least Privilege)
DB_ROLE_IDENTITY_USER=identity_svc
DB_ROLE_IDENTITY_PASS=replace_with_identity_pass
DB_ROLE_LEDGER_USER=ledger_svc
DB_ROLE_LEDGER_PASS=replace_with_ledger_pass
DB_ROLE_TRADING_USER=trading_svc
DB_ROLE_TRADING_PASS=replace_with_trading_pass
DB_ROLE_ADMIN_USER=admin_svc
DB_ROLE_ADMIN_PASS=replace_with_admin_pass

# Redis 7 (Ephemeral Cache, Distributed Locks, Rate Limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password
REDIS_TLS=false

# NATS JetStream (Event Bus)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=exchange-events
NATS_CLIENT_ID=exchange-service
NATS_TOKEN=replace_with_nats_token

# EVM Settlement Chain (Base L2 / Arbitrum L2 / Local Anvil)
CHAIN_ID=84532 # Base Sepolia Testnet (or 31337 for local Anvil)
RPC_URL=https://sepolia.base.org
WS_RPC_URL=wss://sepolia.base.org
VAULT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
SETTLEMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ACCOUNT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Operator & Signing Keys (KMS / HSM in Production)
OPERATOR_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
# For local sandbox testing only - production uses AWS KMS / GCP Cloud KMS / Vault
LOCAL_DEV_OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
LOCAL_DEV_SETTLEMENT_SIGNER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# WebAuthn / Passkeys Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Hybrid Exchange Platform
WEBAUTHN_ORIGIN=http://localhost:3000
ADMIN_WEBAUTHN_ORIGIN=http://localhost:3001

# JWT & Session Secrets
JWT_SECRET=replace_with_random_64_byte_hex_secret
SESSION_COOKIE_SECRET=replace_with_random_64_byte_hex_secret
ADMIN_SESSION_SECRET=replace_with_separate_admin_64_byte_hex_secret

# Fiat Providers (Sandbox / Mock)
STITCH_CLIENT_ID=sandbox_stitch_client_id
STITCH_CLIENT_SECRET=sandbox_stitch_client_secret
STITCH_WEBHOOK_SECRET=sandbox_stitch_webhook_secret

# Notification Providers
SENDGRID_API_KEY=sandbox_sendgrid_api_key
TWILIO_ACCOUNT_SID=sandbox_twilio_sid
TWILIO_AUTH_TOKEN=sandbox_twilio_token

# Supabase (Managed PostgreSQL & Realtime Events)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Vercel Deployment
VERCEL_ENV=production
VERCEL_URL=https://your-exchange.vercel.app

